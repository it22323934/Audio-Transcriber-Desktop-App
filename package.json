{
  "name": "toru-desktop",
  "productName": "TORU",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop meeting notes: listens to your mic and your computer's audio (Teams, Zoom, Slack, Meet…), transcribes live and writes AI-enhanced notes.",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "icons": "node scripts/gen-icons.mjs",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "dist": "npm run build && electron-builder --win",
    "test:unit": "node --test tests/unit.test.ts",
    "test:perf": "npm run build && node tests/perf.mjs"
  },
  "author": "Asiri Jayawardena",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  },
  "build": {
    "appId": "com.toru.desktop",
    "productName": "TORU",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TORU",
      "artifactName": "TORU-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ]
  },
  "dependencies": {
    "koffi": "^3.3.8"
  }
}
